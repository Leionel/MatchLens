# Raw upstream provider payloads. Reproducible via scripts/fetch_statsbomb_open_data.py;
# the imported datasets and the source manifest are committed instead.
data/raw/

# Imported provider payloads are derived data and stay out of git under the
# StatsBomb Public Data User Agreement (no redistribution of provider payloads).
# Reproducible via scripts/ingest_statsbomb_corpus.py from data/raw/.
data/datasets/

# Playwright writes failure traces into this folder and CI uploads them as
# artifacts; the bootstrapped session cookie is a live credential for the local
# server. Neither belongs in history.
apps/web/e2e/.artifacts/
apps/web/e2e/.playwright-report/
apps/web/e2e/.auth.json

