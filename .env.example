# Copy to .env at repository root. Server only; never NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=
# Default global, persistent ceilings; do not reset to evade an agreed budget.
MATCHLENS_MAX_REQUESTS=32
MATCHLENS_MAX_RESERVED_USD=1
# Detection is always free. Enable paid automatic investigations explicitly.
MATCHLENS_AUTO_ANALYSE=0
# Hard-bounded to at most two automatic runs per session.
MATCHLENS_AUTO_RUNS_PER_SESSION=2
# Optional absolute location on a persistent volume:
# MATCHLENS_RUNTIME_DIR=/data/matchlens
# Editorial approval is closed unless one of these server-side tokens is set.
# Never expose these to the browser; producers enter the token in the UI field.
# MATCHLENS_PRODUCER_TOKEN=change-me
# MATCHLENS_ADMIN_TOKEN=change-me
# For a local-only producer preview, explicitly opt in (never on public hosts):
# MATCHLENS_ALLOW_LOCAL_PRODUCER=0

# --- Container / Railway deployment ---------------------------------------
# Runtime state (session ledger, run records) and provider payloads must live
# on the persistent volume, otherwise they are lost on every deploy.
# MATCHLENS_RUNTIME_DIR=/data/matchlens
# MATCHLENS_DATA_DIR=/data/matchlens/data
# Licensed payloads are never baked into the image; one complete match is
# fetched and imported on first boot. Set to 0 to disable.
# MATCHLENS_BOOTSTRAP=1
# MATCHLENS_BOOTSTRAP_MATCH=sb_3795221
# MATCHLENS_BOOTSTRAP_TIMEOUT=90
